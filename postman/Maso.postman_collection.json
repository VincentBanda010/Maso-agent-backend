                  " pm.test(\"Valid model verdict\", () => { pm.expect(r.risk_level).to.be.oneOf([\"Safe\", \"Suspicious\", \"Dangerous\"]); pm.expect(r.score).to.be.a(\"number\").within(0,100); pm.expect(r.score % 1).to.eql(0); });",
                  " pm.test(\"Verdict color matches\", () => pm.expect(r.color).to.eql({Safe:\"green\", Suspicious:\"yellow\", Dangerous:\"red\"}[r.risk_level]));",
                  " pm.test(\"Network checks were not requested\", () => { pm.expect(r.checks.link_expansion).to.eql(\"not_requested\"); pm.expect(r.checks.threat_intelligence).to.eql(\"not_requested\"); });",
                  " pm.test(\"Limitations disclosed\", () => pm.expect(r.limitations).to.be.an(\"array\").that.is.not.empty);",
                  " console.log(\"Model result\", {risk_level:r.risk_level, score:r.score, elapsed_ms:r.elapsed_ms});",
                  "}"
                ]
              }
            }
          ]
        },
